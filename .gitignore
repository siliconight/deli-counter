# Build outputs — regenerable from specs, kept out of source control.
# (If you decide to commit release models, whitelist them explicitly below.)
build/*.glb
build/*.gltf
build/*.bin
build/*.obj
build/*.mtl
build/textures/
build/floorplans/

# Keep manifests tracked: they are the traceability record (text, tiny).
!build/*.manifest.json

__pycache__/
*.pyc
*.blend1

# Versioned release zips — build artifacts, attach to GitHub Releases instead.
dist/

# Local validation scratch (one-off walk drivers — not part of the tool).
# Root-anchored so the tracked recipe at docs/themes/gasstation/ is unaffected.
/phase4_walk.*
/resolver_check.py
/make_wall_module.py
/walk_test.gd
# Test module library the resolver walk writes into.
/dc-modules/

# Phase 0 evidence reports — regenerated by evidence.py / roundtrip.py /
# review_render.py on every build; the registry references them by path,
# CI/releases retain them. Manifests above stay tracked as before.
build/*.validation.json
build/*.combat_audit.json
build/*.navigation.json
build/*.roundtrip.json
build/*.gameplay.json
build/*.lights.json
build/*.slots.json
build/*.glb.spec.sha256
build/review/

# Advisory AI review (ai_review.py) — regenerable, non-deterministic, never gates.
build/*.ai_review.json
build/.ai_review_cache/

# Level Factory pipeline artifacts written into specs/ by LF's deli adapter
# (transient build inputs, regenerated per run; not DC's authored library).
specs/lf_*.json

# scratch and editor backups -- copies of tracked files, not history.
# A RULE, not a list: each patch_*.py invents its own suffix, so any
# enumeration of them falls behind the next patch that gets written.
# This file carried six suffixes and had already fallen five behind --
# pre_cap, pre_inset, pre_parapet, pre_plate, pre_plate2 were all
# offered up as untracked files. The factory root uses the rule form.
_bridge/
*.pre_*

# scratch and unread build sidecars
_scratch_archive/


# Nav gate verdicts -- regenerated by nav_gate.py on every build, like the
# validation/combat_audit/navigation reports above.
build/*.navgate.json
